rules_version = '2';

/* ===========================================================================
   EICT — STAGE ONE rules (transitional)

   Publish THIS file first, while Class.html is still the old version.

   It does three things:
     - gives the teacher dashboard everything it needs to read and write
     - keeps the current Class.html and the public EICT site working exactly
       as they do today, including sign-up, enquiries and slot holds
     - closes the worst hole straight away: a student can no longer read the
       whole seasons collection, only the seasons you opened for them

   What it deliberately does NOT do yet: force every account to have a
   role and a status. The old sign-up form does not write those fields, so
   demanding them here would stop new students registering.

   Replace this with firestore.rules once the new Class.html is live.
   =========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------- helpers */

    function signedIn() { return request.auth != null; }

    function me() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    function meExists() {
      return signedIn() &&
             exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    function isTeacher() {
      return meExists() && me().role == 'teacher';
    }

    // Lenient on purpose during the changeover: an account counts as a student
    // if it is not suspended. Records migrated to status 'active' pass, and so
    // do old records that have no status field at all.
    function isStudentish() {
      return meExists() && me().role != 'teacher' && me().get('status', 'active') != 'suspended';
    }

    function hasMonth(month) {
      return signedIn() &&
             exists(/databases/$(database)/documents/access/$(request.auth.uid + '_' + month));
    }

    /* ------------------------------------------------------------ students */

    match /students/{uid} {

      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);

      // The old sign-up form is allowed through, but it still cannot make
      // itself a teacher, give itself a student number, or mark itself paid.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.get('role', 'student') == 'student'
                    && request.resource.data.get('studentNo', null) == null
                    && request.resource.data.get('paidLive', false) == false
                    && request.resource.data.get('unlocked', []).size() == 0;

      // Profile and progress only. Access fields are absent from this list,
      // so any attempt to change them fails.
      allow update: if isTeacher()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['name','whatsapp','school','address',
                                       'photoURL','track','watched','progress',
                                       'theme','lastSeenAt','updatedAt']));

      allow delete: if isTeacher();
    }

    /* ------------------------------------------------- new collections --- */

    match /counters/{id} {
      allow read, write: if isTeacher();
    }

    match /access/{id} {
      allow read:  if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isTeacher();
    }

    match /payments/{id} {
      allow read:   if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isTeacher();
    }

    match /freeRequests/{id} {
      allow read:   if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isTeacher();
    }

    /* --------------------------------------------------------------- slips */

    // The slip IMAGE, kept apart from the payment record on purpose.
    //
    // Cloud Storage needs a paid plan, so the picture is compressed in the
    // browser and stored here as a base64 string. Keeping it in its own
    // document means the Payments list reads only names and amounts; the
    // picture is fetched one at a time, when the teacher actually looks at
    // it. Putting it inside payments/{id} would pull every image on every
    // page load and burn through the daily read quota.
    //
    // Document id is the payment id it belongs to.
    match /slips/{payId} {
      allow read:   if isTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 900000;
      allow update, delete: if isTeacher();
    }

    /* -------------------------------------------------------------- class chat
       One shared conversation per batch. The parent document holds only a
       cheap summary (lastAt/lastText) so checking "is there anything new"
       is a single document read, not a query — that is what drives the
       unread dot before a student has ever opened Chat. The real messages
       live in the subcollection underneath. */
    match /classChat/{batch} {
      allow read:  if isTeacher() || isStudentish();
      allow write: if isTeacher() || isStudentish();

      match /messages/{id} {
        allow read:   if isTeacher() || isStudentish();
        allow create: if (isTeacher() || isStudentish())
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() < 2000;
        allow update, delete: if isTeacher();     // moderation only
      }
    }

    /* ---------------------------------------------------------- direct message
       One thread per student, id equal to their own uid — so a student's
       own thread is trivially theirs, no field to check, the path itself is
       the ownership proof. Sir reads and writes every thread; a student
       only ever their own. */
    match /dmThreads/{uid} {
      allow read:  if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow write: if isTeacher() || (signedIn() && request.auth.uid == uid);

      match /messages/{id} {
        allow read:   if isTeacher() || (signedIn() && request.auth.uid == uid);
        allow create: if (isTeacher() || (isStudentish() && request.auth.uid == uid))
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() < 2000;
        allow update, delete: if isTeacher();
      }
    }

    /* ------------------------------------------------------------ term tests */

    // The exam definitions: which units, the booking window, the timing
    // structure, paper clues. Every active student needs to read these to
    // know what is coming and to book a sitting; only sir writes them.
    match /termTests/{id} {
      allow read:  if isTeacher() || isStudentish();
      allow write: if isTeacher();
    }

    // One booking per student per term test, id {uid}_{termTestId}. The
    // schedule is frozen onto this document the moment it is created, so a
    // later edit to the term test's default timing never reshuffles a
    // sitting someone already has. A student can book once; only sir can
    // reschedule or clear a booking after that — the paper has already gone
    // in the post by then.
    match /termBookings/{id} {
      allow read:   if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isStudentish()
                    && request.resource.data.uid == request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.termTestId;
      allow update, delete: if isTeacher();
    }

    /* -------------------------------------------------------------- papers */

    // Answer papers. The file itself stays in the student's own Drive; this
    // holds only the link and the marking. Document id is {uid}_{key}, which
    // makes a second submission for the same paper overwrite the first rather
    // than piling up.
    match /papers/{id} {

      allow read: if isTeacher()
                  || (signedIn() && resource.data.uid == request.auth.uid);

      // A student may send and resend their own paper, but never mark it.
      // status, marks and feedback are sir's alone.
      allow create: if isStudentish()
                    && request.resource.data.uid == request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.key
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.marks == null
                    && request.resource.data.driveId is string
                    && request.resource.data.driveId.size() < 200;

      allow update: if isTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid
                        && request.resource.data.status == 'submitted'
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.marks == null);

      allow delete: if isTeacher();
    }

    /* --------------------------------------------------------------- slots */

    // Term test sittings. Every student needs to see what is on offer, so
    // read is open to the class; only sir creates them.
    match /slots/{id} {
      allow read:  if isTeacher() || isStudentish();
      allow write: if isTeacher();
    }

    /* ------------------------------------------------------------ bookings */

    match /bookings/{id} {
      allow read:   if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isStudentish()
                    && request.resource.data.uid == request.auth.uid
                    && id == request.auth.uid + '_term-' + string(request.resource.data.term);
      allow delete: if isTeacher();
    }

    /* ------------------------------------------------------------- seasons */

    // This is the one real tightening in stage one. Class.html already fetches
    // the video id only at the moment an episode is opened, and lets the rules
    // decide, so this needs no change to the student page.
    match /seasons/{seasonId} {
      allow read:  if isTeacher()
                   || (isStudentish() && me().get('unlocked', []).hasAny([resource.data.season]));
      allow write: if isTeacher();
    }

    /* ---------------------------------------------------------- attendance */

    // One document per student per month, id {uid}_{month}. A student can
    // read only their own — this is the whole reason it is split this way
    // rather than one shared register: nobody should be able to read who
    // else was in the class. Absence is the default; a date only appears in
    // `sessions` when the student was marked present, so most months this
    // document is small.
    match /liveSessions/{id} {
      allow read: if isTeacher()
                  || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isTeacher();
    }

    // The dates a register was taken on, and that day's recording for
    // whoever missed it. No attendee list here — that is what keeps this
    // one safe for every active student to read.
    match /liveMeta/{month} {
      allow read:  if isTeacher() || isStudentish();
      allow write: if isTeacher();
    }

    /* ------------------------------------------------------------ settings */

    // Bank details, fee, day and time. Any approved student may read these —
    // somebody who has not paid yet is exactly the person who needs to know
    // where to pay. Keep nothing private in here.
    match /settings/public {
      allow read:  if isTeacher() || isStudentish();
      allow write: if isTeacher();
    }

    match /settings/{docId} {
      allow read, write: if isTeacher();
    }

    /* ------------------------------------------- unchanged from today --- */

    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['name','whatsapp','school','type','batch','slot',
                         'fee','at','uid','note','email'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 120;
      allow read, update, delete: if isTeacher();
    }

    match /holds/{id} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasOnly(['slot','at','name','whatsapp'])
                    && request.resource.data.slot is string
                    && request.resource.data.slot.size() < 120;
      allow update, delete: if isTeacher();
    }

    match /views/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    /* ---------------------------------------------------------- page stats
       Visitor counters written by track.js, read by Stats.html. One document
       per page per day, id {page}_{YYYY-MM-DD}. Anyone may add one to a
       counter; nobody may lower, reset or add anything else. Only you read. */
    match /pageStats/{id} {
      function statsReader() {
        return request.auth != null
               && (request.auth.token.email == 'ushithasamudaya@gmail.com'
                   || get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'teacher');
      }
      function before() {
        return resource == null ? {} : resource.data;
      }
      // A counter either stays the same or goes up by exactly one.
      function step(k) {
        return !(k in request.resource.data)
               || request.resource.data[k] == before().get(k, 0)
               || request.resource.data[k] == before().get(k, 0) + 1;
      }
      allow read: if statsReader();
      allow create, update: if request.resource.data.keys().hasOnly(['page','date',
                    'views',
                    'visitors',
                    'newVisitors',
                    'mobile',
                    'desktop',
                    'h00',
                    'h01',
                    'h02',
                    'h03',
                    'h04',
                    'h05',
                    'h06',
                    'h07',
                    'h08',
                    'h09',
                    'h10',
                    'h11',
                    'h12',
                    'h13',
                    'h14',
                    'h15',
                    'h16',
                    'h17',
                    'h18',
                    'h19',
                    'h20',
                    'h21',
                    'h22',
                    'h23',
                    'src_direct',
                    'src_site',
                    'src_whatsapp',
                    'src_facebook',
                    'src_youtube',
                    'src_google',
                    'src_tiktok',
                    'src_instagram',
                    'src_other'])
                    && request.resource.data.page is string
                    && request.resource.data.page.matches('^[A-Za-z0-9-]{1,40}$')
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
                    && id == request.resource.data.page + '_' + request.resource.data.date
                    && step('views')
                    && step('visitors')
                    && step('newVisitors')
                    && step('mobile')
                    && step('desktop')
                    && step('h00')
                    && step('h01')
                    && step('h02')
                    && step('h03')
                    && step('h04')
                    && step('h05')
                    && step('h06')
                    && step('h07')
                    && step('h08')
                    && step('h09')
                    && step('h10')
                    && step('h11')
                    && step('h12')
                    && step('h13')
                    && step('h14')
                    && step('h15')
                    && step('h16')
                    && step('h17')
                    && step('h18')
                    && step('h19')
                    && step('h20')
                    && step('h21')
                    && step('h22')
                    && step('h23')
                    && step('src_direct')
                    && step('src_site')
                    && step('src_whatsapp')
                    && step('src_facebook')
                    && step('src_youtube')
                    && step('src_google')
                    && step('src_tiktok')
                    && step('src_instagram')
                    && step('src_other');
      allow delete: if statsReader();
    }

    /* --------------------------------------------------------- catch‑all */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
